}}}{{{#!style
.namu-game { width: 300px; max-width: 100%; margin: 12px auto; padding: 10px; border-radius: 8px; background: #bbada0; color: #776e65; font-family: sans-serif; }
.namu-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
.namu-title { font-size: 28px; font-weight: bold; white-space: nowrap; }
.namu-msg { display: none; margin-bottom: 8px; font-weight: bold; color: #f9f6f2; text-align: center; }
.namu-game.namu-won .namu-win { display: block; }
.namu-game.namu-over .namu-lose { display: block; }
.namu-new { white-space: nowrap; padding: 4px 10px; border-radius: 4px; background: #8f7a66; color: #f9f6f2; cursor: pointer; }
.namu-board { display: flex; flex-wrap: wrap; }
.namu-cell { width: 25%; height: 66px; overflow: hidden; border: 4px solid #bbada0; border-radius: 8px; background: #cdc1b4; box-sizing: border-box; }
.namu-n { display: none; height: 58px; align-items: center; justify-content: center; font-size: 26px; font-weight: bold; }
