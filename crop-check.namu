{{{#!style
.ck { width: 420px; max-width: 100%; margin: 12px auto; font-family: sans-serif; }
.ck-t { font-weight: bold; margin: 12px 0 4px; }
.ck-row { display: flex; gap: 8px; }
.ck-slot { width: 100px; height: 100px; overflow: hidden; border: 1px solid #888; }
.ck-in { width: 400px; }
.ck-p6 .ck-in { margin-top: -100px; margin-left: -200px; }
.ck-p11 .ck-in { margin-top: -200px; margin-left: -300px; }
.ck-p16 .ck-in { margin-top: -300px; margin-left: -300px; }
.ck-move .ck-in { margin-top: -300px; margin-left: 0; }
.ck-btn { cursor: pointer; background: #dbeafe; padding: 4px 8px; border-radius: 4px; display: inline-block; margin: 4px 0; }
.ck-d .ck-slot img { width: 400px; max-width: none; }
