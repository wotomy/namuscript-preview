}}}{{{#!style
.lights_out-game { width: 300px; max-width: 100%; padding: 12px; margin: 12px auto; border: 1px solid #334155; border-radius: 12px; background: #0f172a; color: #e2e8f0; }
.lights_out-title { font-size: 20px; font-weight: bold; margin-bottom: 8px; }
.lights_out-playing, .lights_out-won { font-size: 12px; margin-bottom: 8px; }
.lights_out-won { display: none; }
.lights_out-row { display: flex; gap: 6px; margin-top: 6px; }
.lights_out-cell { width: 20%; height: 48px; border-radius: 6px; background: #facc15; cursor: pointer; }
