.minesweeper_6x6 .minesweeper_6x6-game { width: 384px; max-width: 100%; padding: 12px; margin: 12px auto; border: 1px solid #b8c4d4; border-radius: 12px; background: #f1f5f9; color: #17365a; }
.minesweeper_6x6 .minesweeper_6x6-title { font-size: 20px; font-weight: bold; margin-bottom: 8px; }
.minesweeper_6x6 .minesweeper_6x6-playing,.minesweeper_6x6  .minesweeper_6x6-won,.minesweeper_6x6  .minesweeper_6x6-lost-message,.minesweeper_6x6  .minesweeper_6x6-help { font-size: 12px; }
.minesweeper_6x6 .minesweeper_6x6-toolbar { display: flex; gap: 8px; margin: 12px 0; }
.minesweeper_6x6 .minesweeper_6x6-button { display: inline-block; padding: 8px; border-radius: 5px; background: #dbe5f1; cursor: pointer; }
.minesweeper_6x6 .minesweeper_6x6-game.minesweeper_6x6-mode .minesweeper_6x6-mode-button { background: #fcd34d; }
.minesweeper_6x6 .minesweeper_6x6-row { display: flex; gap: 4px; margin-top: 4px; }
.minesweeper_6x6 .minesweeper_6x6-cell { width: 16.666%; border: 1px solid #b4c6df; border-radius: 5px; overflow: hidden; text-align: center; }
.minesweeper_6x6 .minesweeper_6x6-face,.minesweeper_6x6  .minesweeper_6x6-answer { display: flex; align-items: center; justify-content: center; height: 42px; padding: 0; font-size: 20px; font-weight: bold; }
.minesweeper_6x6 .minesweeper_6x6-face { background: #dce6f2; cursor: pointer; }
.minesweeper_6x6 .minesweeper_6x6-answer { background: #fee2e2; }
.minesweeper_6x6 .minesweeper_6x6-safe .minesweeper_6x6-answer { background: #fff; }
.minesweeper_6x6 .minesweeper_6x6-n0 .minesweeper_6x6-answer { color: transparent; }
.minesweeper_6x6 .minesweeper_6x6-n1 .minesweeper_6x6-answer { color: #245aff; }
