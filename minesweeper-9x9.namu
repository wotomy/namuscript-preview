}}}{{{#!if commands_738=";add-class,minesweeper_9x9_node_575,minesweeper_9x9-lost"
}}}{{{#!style
.minesweeper_9x9-game { width: 432px; max-width: 100%; padding: 12px; margin: 12px auto; border: 1px solid #b8c4d4; border-radius: 12px; background: #f1f5f9; color: #17365a; }
.minesweeper_9x9-title { font-size: 20px; font-weight: bold; margin-bottom: 8px; }
.minesweeper_9x9-playing, .minesweeper_9x9-won, .minesweeper_9x9-lost-message, .minesweeper_9x9-help { font-size: 12px; }
.minesweeper_9x9-playing, .minesweeper_9x9-won, .minesweeper_9x9-lost-message { margin-bottom: 8px; }
.minesweeper_9x9-row { display: flex; gap: 3px; margin-top: 3px; }
.minesweeper_9x9-cell { width: 11.111%; height: 38px; border: 1px solid #b4c6df; border-radius: 4px; overflow: hidden; background: #dce6f2; text-align: center; }
.minesweeper_9x9-cover, .minesweeper_9x9-flag, .minesweeper_9x9-answer { display: flex; align-items: center; justify-content: center; height: 38px; padding: 0; font-size: 17px; font-weight: bold; }
.minesweeper_9x9-cover { background: #dce6f2; cursor: pointer; }
.minesweeper_9x9-cover:hover { background: #c9d7ea; }
.minesweeper_9x9-flag { width: 15px; height: 15px; margin: -37px 1px 22px auto; border-radius: 3px; background: #f8fafc; font-size: 9px; cursor: pointer; }
.minesweeper_9x9-flag:hover { background: #fde68a; }
.minesweeper_9x9-answer { background: #fff; }
.minesweeper_9x9-n9 .minesweeper_9x9-answer { background: #fee2e2; }
.minesweeper_9x9-n0 .minesweeper_9x9-answer { color: transparent; }
.minesweeper_9x9-n1 .minesweeper_9x9-answer { color: #245aff; }
.minesweeper_9x9-n2 .minesweeper_9x9-answer { color: #008846; }
.minesweeper_9x9-n3 .minesweeper_9x9-answer { color: #cc3030; }
.minesweeper_9x9-n4 .minesweeper_9x9-answer { color: #9a46ad; }
.minesweeper_9x9-n5 .minesweeper_9x9-answer { color: #b45309; }
.minesweeper_9x9-n6 .minesweeper_9x9-answer { color: #0e7490; }
.minesweeper_9x9-n7 .minesweeper_9x9-answer { color: #334155; }
.minesweeper_9x9-n8 .minesweeper_9x9-answer { color: #64748b; }
/* 답은 버튼 아래에 있어 칸 높이(overflow: hidden) 밖에 가려지고, 버튼을 숨기면 올라와 보입니다. */
.minesweeper_9x9-won, .minesweeper_9x9-lost-message { display: none; }
.minesweeper_9x9-game .minesweeper_9x9-cell.minesweeper_9x9-flagged .minesweeper_9x9-cover { display: none; }
.minesweeper_9x9-game .minesweeper_9x9-cell.minesweeper_9x9-flagged .minesweeper_9x9-flag { width: auto; height: 38px; margin: 0; border-radius: 0; background: #dce6f2; font-size: 17px; }
.minesweeper_9x9-help { margin-top: 8px; }
.minesweeper_9x9-game.minesweeper_9x9-w0 .minesweeper_9x9-s0 .minesweeper_9x9-cover, .minesweeper_9x9-game.minesweeper_9x9-w0 .minesweeper_9x9-s0 .minesweeper_9x9-flag { display: none; }
.minesweeper_9x9-game.minesweeper_9x9-w1 .minesweeper_9x9-s1 .minesweeper_9x9-cover, .minesweeper_9x9-game.minesweeper_9x9-w1 .minesweeper_9x9-s1 .minesweeper_9x9-flag { display: none; }
