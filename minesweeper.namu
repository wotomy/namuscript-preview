}}}{{{#!style
.minesweeper-game { width: 320px; max-width: 100%; padding: 12px; margin: 12px auto; border: 1px solid #b8c4d4; border-radius: 12px; background: #f1f5f9; color: #17365a; }
.minesweeper-title { font-size: 20px; font-weight: bold; margin-bottom: 8px; }
.minesweeper-playing, .minesweeper-won, .minesweeper-lost-message, .minesweeper-help { font-size: 12px; }
.minesweeper-toolbar { display: flex; gap: 8px; margin: 12px 0; }
.minesweeper-button { display: inline-block; padding: 8px; border-radius: 5px; background: #dbe5f1; cursor: pointer; }
.minesweeper-game.minesweeper-mode .minesweeper-mode-button { background: #fcd34d; }
.minesweeper-row { display: flex; gap: 4px; margin-top: 4px; }
.minesweeper-cell { width: 20%; border: 1px solid #b4c6df; border-radius: 5px; overflow: hidden; text-align: center; }
.minesweeper-face, .minesweeper-answer { display: flex; align-items: center; justify-content: center; height: 42px; padding: 0; font-size: 20px; font-weight: bold; }
.minesweeper-face { background: #dce6f2; cursor: pointer; }
.minesweeper-answer { background: #fee2e2; }
.minesweeper-safe .minesweeper-answer { background: #fff; }
.minesweeper-n0 .minesweeper-answer { color: transparent; }
.minesweeper-n1 .minesweeper-answer { color: #245aff; }
.minesweeper-n2 .minesweeper-answer { color: #008846; }
.minesweeper-n3 .minesweeper-answer { color: #cc3030; }
.minesweeper-n4 .minesweeper-answer { color: #9a46ad; }
.minesweeper-mark, .minesweeper-unflag, .minesweeper-answer, .minesweeper-flag-help, .minesweeper-won, .minesweeper-lost-message { display: none; }
.minesweeper-game.minesweeper-mode .minesweeper-cell .minesweeper-cover { display: none; }
.minesweeper-game.minesweeper-mode .minesweeper-cell .minesweeper-mark { display: flex; }
.minesweeper-game .minesweeper-cell.minesweeper-flagged .minesweeper-cover, .minesweeper-game .minesweeper-cell.minesweeper-flagged .minesweeper-mark { display: none; }
.minesweeper-game .minesweeper-cell.minesweeper-flagged .minesweeper-unflag { display: flex; }
.minesweeper-game.minesweeper-mode .minesweeper-normal-help { display: none; }
.minesweeper-game.minesweeper-mode .minesweeper-flag-help { display: block; }
.minesweeper-help { margin-top: 6px; }
.minesweeper-game.minesweeper-o0 .minesweeper-cell.minesweeper-c0.minesweeper-safe .minesweeper-face { display: none; }
.minesweeper-game.minesweeper-o0 .minesweeper-cell.minesweeper-c0.minesweeper-safe .minesweeper-answer { display: flex; }
.minesweeper-game.minesweeper-o1 .minesweeper-cell.minesweeper-c1.minesweeper-safe .minesweeper-face { display: none; }
.minesweeper-game.minesweeper-o1 .minesweeper-cell.minesweeper-c1.minesweeper-safe .minesweeper-answer { display: flex; }
.minesweeper-game.minesweeper-o2 .minesweeper-cell.minesweeper-c2.minesweeper-safe .minesweeper-face { display: none; }
.minesweeper-game.minesweeper-o2 .minesweeper-cell.minesweeper-c2.minesweeper-safe .minesweeper-answer { display: flex; }
.minesweeper-game.minesweeper-o3 .minesweeper-cell.minesweeper-c3.minesweeper-safe .minesweeper-face { display: none; }
.minesweeper-game.minesweeper-o3 .minesweeper-cell.minesweeper-c3.minesweeper-safe .minesweeper-answer { display: flex; }
.minesweeper-game.minesweeper-o4 .minesweeper-cell.minesweeper-c4.minesweeper-safe .minesweeper-face { display: none; }
.minesweeper-game.minesweeper-o4 .minesweeper-cell.minesweeper-c4.minesweeper-safe .minesweeper-answer { display: flex; }
.minesweeper-game.minesweeper-o5 .minesweeper-cell.minesweeper-c5.minesweeper-safe .minesweeper-face { display: none; }
